
# ==========================================
# PROCESSED DATASETS
# ==========================================
**/data/processed/*.npy
**/data/processed/*.npz

# ==========================================
# RAW DATASETS
# ==========================================
**/data/raw/
ember-master/

# Keep only the EMBER source files needed by the backend.
# Do not ignore the entire ember/ directory because
# Docker needs ember/ember/features.py.
# Review the files before committing.

# ==========================================
# TRAINED MODELS
# ==========================================
# Model files are excluded because they may be large.
# Provide them separately if needed to run the backend.
models/*.joblib
models/*.pkl
models/*.model

